<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home Screen"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="24dp" />

        <!-- Add Expense -->
        <Button
            android:id="@+id/btnAddExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Add Expense"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:padding="12dp" />

        <!-- View Summary -->
        <Button
            android:id="@+id/btnViewSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="View Summary"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:padding="12dp" />

        <!-- View Budget Graph -->
        <Button
            android:id="@+id/btnViewBudgetGraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="View Budget Graph"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:padding="12dp" />

        <!-- Goal Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Monthly Goals"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:paddingBottom="8dp" />

        <!-- Min Goal -->
        <EditText
            android:id="@+id/minGoalEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter minimum goal"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <!-- Max Goal -->
        <EditText
            android:id="@+id/maxGoalEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter maximum goal"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Save Goal -->
        <Button
            android:id="@+id/saveGoalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Goal"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:padding="12dp" />

        <!-- Goal Preview -->
        <TextView
            android:id="@+id/goalPreviewText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No goal set yet."
            android:textSize="16sp"
            android:layout_marginTop="16dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This month:"
            android:textSize="16sp"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/dailySpendingTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Spent today: --"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSearchExpenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Search Expenses" />

    </LinearLayout>
</ScrollView>
